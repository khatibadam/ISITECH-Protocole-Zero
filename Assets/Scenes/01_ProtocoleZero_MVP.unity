--- !u!102 &167290972
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 167290970}
  m_Text: "23h47. Coupure generale. Tu es seul au 3e etage.\n\n1. Reveille ton PC
    (clavier) : la musique t'ancre.\n2. Tableau BT de MARS : branche le cable dans
    son port.\n3. LOCAL INFO au fond du couloir : rebranche les 2\n   cables en respectant
    les couleurs.\n4. Courant retabli : sors par la porte du hall\n   (2 poignees)
    ou appelle l'ascenseur.\n\nDEPLACEMENT : vise un pad turquoise au sol\n(stick
    avant, relache) ou choisis un mode :"
  m_OffsetZ: 0
  m_CharacterSize: 0.008
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 34
  m_FontStyle: 0
  m_RichText: 1
  m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
  m_Color:
    serializedVersion: 2
    rgba: 4294963947
